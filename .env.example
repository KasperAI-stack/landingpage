# Skabelon. Kopiér til .env og udfyld. .env kommer aldrig på GitHub eller online.

# Google Tag Manager API (OAuth)
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=

# Containeren. Konto-ID og det interne container-ID står i adressen i GTM:
# tagmanager.google.com/#/container/accounts/<KONTO-ID>/containers/<CONTAINER-ID>/...
GTM_PUBLIC_ID=GTM-N7M37V72
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
